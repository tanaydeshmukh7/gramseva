# Gramसेवा Environment Configuration Example
# Copy this file to .env.local and configure your environment variables.

# 1. Google Sheets Webhook Secret
# Shared authentication secret between Gramसेवा and Google Apps Script
GRAMSEVA_WEBHOOK_SECRET=your_secure_webhook_secret_here

# 2. Public App URL (Used for webhook callbacks and deep linking)
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# 3. Server-Side Authentication
# Set your admin username and salted bcrypt hash of your admin password
ADMIN_USERNAME=kalyugkadevta
ADMIN_PASSWORD_HASH=$2b$12$r8..cQFt/EZ422ezeTXIuuS0vN1UYj5zb6FsNT5lEF76MlpWTU.v.
SESSION_SECRET=your_32_character_session_encryption_secret_here

# 4. Supabase PostgreSQL Persistence Configuration
# Used for serverless settings, sync logs, and database persistence
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
